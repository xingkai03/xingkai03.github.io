---
import { getEntry, render } from 'astro:content';
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import Layout from '../layouts/BlogPost.astro';

// Text lives in src/content/pages/about.md (editable at /admin → "About page").
const about = await getEntry('pages', 'about');
if (!about) throw new Error('Missing src/content/pages/about.md');
const { Content } = await render(about);
---

<Layout title={about.data.title} description={about.data.description} heroImage={AboutHeroImage}>
	<Content />
</Layout>
