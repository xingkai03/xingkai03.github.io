---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { CV_URL, EMAIL, GITHUB_URL, LINKEDIN_URL, OPEN_TO, SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { projects } from '../data/projects';

const featured = projects.filter((project) => project.featured);
const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${SITE_TITLE} · Medical Engineering, KTH`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Xingkai Fang</h1>
				<p class="tagline">
					MSc student in Medical Engineering at KTH Royal Institute of Technology, focused on medical
					imaging and biomedical signal processing.
				</p>
				<p>
					I build tools that make diagnosis and treatment clearer, faster and more useful in real
					clinical work. Before KTH, I studied Biomedical Engineering at Shanghai Jiao Tong University.
				</p>
				<p class="open-to">{OPEN_TO}</p>
				<div class="actions">
					<a class="button primary" href={`mailto:${EMAIL}`}>Email me</a>
					{CV_URL && <a class="button" href={CV_URL}>Download CV</a>}
					{LINKEDIN_URL && <a class="button" href={LINKEDIN_URL} target="_blank" rel="noopener">LinkedIn</a>}
					<a class="button" href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
				</div>
				<p class="languages">
					<strong>Languages:</strong> Chinese (native) · English · German · Swedish (learning)
				</p>
			</section>

			<section>
				<div class="section-head">
					<h2>Selected projects</h2>
					<a href="/projects">All projects →</a>
				</div>
				{featured.map((project) => <ProjectCard project={project} />)}
			</section>

			<section>
				<div class="section-head">
					<h2>Recent writing</h2>
					<a href="/blog">All posts →</a>
				</div>
				<ul class="posts">
					{
						posts.map((post) => (
							<li>
								<a href={`/blog/${post.id}/`}>{post.data.title}</a>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	section + section {
		margin-top: 3rem;
	}
	.hero h1 {
		margin-bottom: 0.25rem;
	}
	.tagline {
		font-size: 1.15em;
		color: rgb(var(--black));
	}
	.open-to {
		padding: 0.6rem 1rem;
		border-left: 4px solid var(--accent);
		background: rgba(var(--gray-light), 50%);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 1.5rem 0 1rem;
	}
	.button {
		padding: 0.45rem 1.1rem;
		border: 1px solid var(--accent);
		border-radius: 8px;
		color: var(--accent);
		font-size: 0.85em;
		text-decoration: none;
	}
	.button:hover {
		background: rgba(35, 55, 255, 0.06);
	}
	.button.primary {
		background: var(--accent);
		color: white;
	}
	.button.primary:hover {
		background: var(--accent-dark);
	}
	.languages {
		color: rgb(var(--gray));
		font-size: 0.85em;
	}
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1rem;
	}
	.section-head a {
		flex-shrink: 0;
		font-size: 0.85em;
		white-space: nowrap;
	}
	.posts {
		padding: 0;
		list-style: none;
	}
	.posts li {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.5rem 0;
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	.posts .date {
		flex-shrink: 0;
		color: rgb(var(--gray));
		font-size: 0.8em;
	}
	@media (max-width: 720px) {
		.posts li {
			flex-direction: column;
			gap: 0;
		}
	}
</style>
